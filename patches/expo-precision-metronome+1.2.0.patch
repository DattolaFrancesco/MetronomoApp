+        let half = fftSize / 2
+
+        pending.withUnsafeBufferPointer { buf in
+            let base = buf.baseAddress! + frameStart
+            vDSP_vmul(base, 1, hann, 1, &windowed, 1, vDSP_Length(fftSize))
+        }
+
+        realp.withUnsafeMutableBufferPointer { rp in
+            imagp.withUnsafeMutableBufferPointer { ip in
+                var split = DSPSplitComplex(realp: rp.baseAddress!, imagp: ip.baseAddress!)
+                windowed.withUnsafeBufferPointer { wp in
+                    wp.baseAddress!.withMemoryRebound(to: DSPComplex.self, capacity: half) { cp in
+                        vDSP_ctoz(cp, 2, &split, 1, vDSP_Length(half))
+                    }
+                }
+                vDSP_fft_zrip(fftSetup, &split, 1, OnsetDetector.log2n, FFTDirection(FFT_FORWARD))
+                vDSP_zvabs(&split, 1, &magnitudes, 1, vDSP_Length(half))
+            }
+        }
+
+        // Representative host-time of this frame's centre.
+        let centreSample = frameStartAbs + Int64(half) - latencyCompensationSamples
+        let gated = isGated(hostSeconds: hostSeconds(forSample: frameStartAbs + Int64(half)))
+
+        if reseedSpectrum {
+            for i in 0..<half { prevMagnitudes[i] = magnitudes[i] }
+            reseedSpectrum = false
+            return
+        }
+
+        if gated {
+            // Don't measure flux across the click's edge or let it pollute
+            // the noise-floor estimate; resync the spectrum for next frame.
+            for i in 0..<half { prevMagnitudes[i] = magnitudes[i] }
+            // Abandon any candidate that was mid-rise when the click hit.
+            inCandidate = false
+            return
+        }
+
+        var flux: Float = 0
+        for k in bandLoBin...bandHiBin {
+            let d = magnitudes[k] - prevMagnitudes[k]
+            if d > 0 { flux += d }
+        }
+        flux /= Float(bandHiBin - bandLoBin + 1)
+        for i in 0..<half { prevMagnitudes[i] = magnitudes[i] }
+
+        let threshold = currentThreshold()
+        pushFlux(flux)
+
+        detectOnset(flux: flux, threshold: threshold, frameSample: centreSample)
+    }
+
+    private func pushFlux(_ flux: Float) {
+        fluxHistory[fluxHistoryHead] = flux
+        fluxHistoryHead = (fluxHistoryHead + 1) % fluxHistory.count
+        if fluxHistoryFill < fluxHistory.count { fluxHistoryFill += 1 }
+    }
+
+    private func currentThreshold() -> Float {
+        guard fluxHistoryFill > 0 else { return OnsetDetector.thresholdFloor }
+        var mean: Float = 0
+        for i in 0..<fluxHistoryFill { mean += fluxHistory[i] }
+        mean /= Float(fluxHistoryFill)
+        var variance: Float = 0
+        for i in 0..<fluxHistoryFill {
+            let d = fluxHistory[i] - mean
+            variance += d * d
+        }
+        variance /= Float(fluxHistoryFill)
+        let std = variance.squareRoot()
+        return max(OnsetDetector.thresholdFloor, mean + OnsetDetector.thresholdK * std)
+    }
+
+    private func detectOnset(flux: Float, threshold: Float, frameSample: Int64) {
+        if !inCandidate {
+            guard flux > threshold,
+                  frameSample - lastOnsetSample > refractorySamples else { return }
+            inCandidate = true
+            candidatePeakFlux = flux
+            candidatePeakSample = frameSample
+            candidateThresholdAtPeak = threshold
+            return
+        }
+
+        if flux > candidatePeakFlux {
+            candidatePeakFlux = flux
+            candidatePeakSample = frameSample
+            candidateThresholdAtPeak = threshold
+            return
+        }
+
+        // Falling — close the candidate once it has clearly come down off
+        // its peak (or dropped back under threshold).
+        if flux < candidatePeakFlux * OnsetDetector.peakReleaseRatio || flux < threshold {
+            emitOnset(peakFlux: candidatePeakFlux,
+                      thresholdAtPeak: candidateThresholdAtPeak,
+                      peakSample: candidatePeakSample)
+            lastOnsetSample = candidatePeakSample
+            inCandidate = false
+        }
+    }
+
+    private func emitOnset(peakFlux: Float, thresholdAtPeak: Float, peakSample: Int64) {
+        let hostSecondsAtPeak = hostSeconds(forSample: peakSample)
+        let hostTimeMs = hostSecondsAtPeak * 1_000
+
+        // strength: how far above the noise-floor estimate this peak sat,
+        // squashed into 0..1. `thresholdAtPeak` already carries the local
+        // mean+k·std; dividing by a few multiples of it keeps a light tap
+        // well below 1 and a hard hit near it.
+        let ratio = peakFlux / max(thresholdAtPeak * 3, 1e-6)
+        let strength = Double(min(max(ratio, 0), 1))
+
+        onsetHandler?(hostTimeMs, strength)
+    }
+}
